<div class="container mx-auto p-4">
  <div class="flex items-center mb-4">
    <img src="https://picsum.photos/id/<%= @user['id'] %>/200/200" alt="<%= @user['username'] %>">
    <div class="ml-4">
      <h1 class="text-3xl"><%= @user['name'] %></h1>
      <p><%= @user['email'] %></p>
    </div>
  </div>
  <h2 class="text-2xl">Albüm Listesi</h2>
  <div class="mt-4 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    <% @albums.each do |album| %>
      <div class="border p-4">
        <h3 class="text-xl"><%= album['title'] %></h3>
        <a href="<%= user_album_path(@user['id'], album['id']) %>" class="text-blue-500">Detayları Gör</a>
      </div>
    <% end %>
  </div>
</div>
