<div class="container mx-auto p-4 bg-gray-100 transform scale-110">
  <h1 class="text-2xl font-bold mb-4 mt-0 pl-5">Kullanıcılar</h1>
  <div class="mb-4 flex pl-5 items-center">
    <input
      type="text"
      id="search"
      placeholder="Kullanıcı Ara"
      onkeyup="filterUsers()"
      class="p-2 border border-gray-300 rounded mr-2"
    />
    <button onclick="clearSearch()" class="p-2 bg-blue-600 text-white rounded hover:bg-blue-700">Temizle</button>
  </div>
  <ul id="users-list" class="pl-5">
    <% @users.each do |user| %>
      <div class="bg-white shadow-md rounded-lg overflow-hidden mb-4">
        <li data-username="<%= user['username'] %>" class="flex items-center p-4">
          <div class="flex-shrink-0">
            <img
              src="<%= user['image_url'] %>"
              alt="<%= user['username'] %>"
              class="w-8 h-8 object-cover rounded-full mr-2 border-2 border-gray-300"
            />
          </div>
          <div>
            <p class="text-lg font-semibold mb-1"><%= user['name'] %></p>
            <p class="text-sm text-gray-500"><%= user['username'] %></p>
          </div>
          <%= link_to "Detaylar", user_path(user['id']), class: "ml-auto rounded-lg py-3 px-5 bg-blue-600 text-white block font-medium text-lg" %>
        </li>
      </div>
    <% end %>
  </ul>
  <p id="no-results" class="hidden mt-4 text-red-500">Kullanıcı Bulunamadı!</p>
</div>

<script>
  function filterUsers() {
    let search = document.getElementById("search").value.toLowerCase();
    let users = document.querySelectorAll("#users-list > div");
    let found = false;

    users.forEach(user => {
      if (user.querySelector('li').dataset.username.toLowerCase().includes(search)) {
        user.classList.remove("hidden");
        found = true;
      } else {
        user.classList.add("hidden");
      }
    });

    document.getElementById("no-results").classList.toggle("hidden", found);
  }

  function clearSearch() {
    document.getElementById("search").value = '';
    filterUsers();
  }
</script>
